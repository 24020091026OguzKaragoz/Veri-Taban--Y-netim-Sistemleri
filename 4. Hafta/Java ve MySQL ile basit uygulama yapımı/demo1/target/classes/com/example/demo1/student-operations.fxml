<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo1.StudentOperationsController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="TC No:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tcNoField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Öğrenci Adı:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="ogrenciAdiField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Öğrenci Telefonu:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="ogrenciTelefonuField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Cinsiyet:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cinsiyetComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Bölüm:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="bolumComboBox" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <TableView fx:id="ogrenciTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="tcNoCol" text="TC No"/>
            <TableColumn fx:id="adCol" text="Adı"/>
            <TableColumn fx:id="telefonCol" text="Telefon"/>
            <TableColumn fx:id="cinsiyetCol" text="Cinsiyet"/>
            <TableColumn fx:id="bolumCol" text="Bölüm"/>
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Öğrencileri Göster" onAction="#ogrencileriGoster"/>
        <Button text="Öğrenci Ekle" onAction="#ogrenciEkle"/>
        <Button text="Seçili Öğrenciyi Güncelle" onAction="#seciliOgrenciyiGuncelle"/>
        <Button text="Seçili Öğrenciyi Sil" onAction="#seciliOgrenciyiSil"/>
    </HBox>
</VBox>