<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo1.AdminOperationsController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <GridPane hgap="10" vgap="10">
        <Label text="Bölüm Adı:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="bolumAdiField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Bölüm Adresi:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="bolumAdresiField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Bölüm Telefonu:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="bolumTelefonuField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <ListView fx:id="bolumListView" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Verileri Göster" onAction="#verileriGoster"/>
        <Button text="Bölüm Ekle" onAction="#bolumEkle"/>
        <Button text="Seçili Bölümü Güncelle" onAction="#seciliBolumuGuncelle"/>
        <Button text="Seçili Bölümü Sil" onAction="#seciliBolumuSil"/>
    </HBox>
</VBox>